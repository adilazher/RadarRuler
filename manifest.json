{
  "manifest_version": 3,
  "name": "FR24 Distance Measure",
  "version": "1.0.0",
  "description": "Adds a geodesic distance-measurement tool to FlightRadar24",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://www.flightradar24.com/*"
  ],
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://www.flightradar24.com/*"],
      "js": ["main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.flightradar24.com/*"],
      "js": ["ui.js"],
      "css": ["ui.css"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
