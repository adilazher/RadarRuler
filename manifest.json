{
  "manifest_version": 3,
  "name": "RadarRuler",
  "version": "1.0.0",
  "description": "Adds a geodesic distance and bearing measurement tool to FlightRadar24 - click to place waypoints, get per-segment distances, and measure multi-leg routes directly on the map.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png"],
      "matches": ["https://www.flightradar24.com/*"]
    }
  ],
  "host_permissions": [
    "https://www.flightradar24.com/*"
  ],
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://www.flightradar24.com/*"],
      "js": ["main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.flightradar24.com/*"],
      "js": ["ui.js"],
      "css": ["ui.css"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
